---
import type { MarkdownInstance } from 'astro';
import SupplementalReader from '../components/SupplementalReader.astro';

const documents = import.meta.glob<MarkdownInstance<Record<string, unknown>>>(
  [
    '../../../book/introduction.md',
    '../../../book/afterword.md',
    '../../../book/reference-answers.md',
  ],
  { eager: true },
);

const pages = [
  { slug: 'introduction', title: '引言', sourceFile: 'book/introduction.md' },
  { slug: 'afterword', title: '后记', sourceFile: 'book/afterword.md' },
  { slug: 'reference-answers', title: '思考题参考答案', sourceFile: 'book/reference-answers.md' },
] as const;

export function getStaticPaths() {
  return pages.map((page) => ({ params: { supplement: page.slug }, props: page }));
}

const { slug, title, sourceFile } = Astro.props;
const document = documents[`../../../${sourceFile}`];
---

<SupplementalReader {document} {slug} {title} {sourceFile} />
