---
import type { MarkdownInstance } from 'astro';
import Header from './Header.astro';
import Layout from '../layouts/Layout.astro';
import { getBook, repo } from '../lib/book';
import { withBase } from '../lib/site-path.mjs';
import '../styles/reader.css';

interface Props {
  document: MarkdownInstance<Record<string, unknown>>;
  slug: 'introduction' | 'afterword' | 'reference-answers';
  title: string;
  sourceFile: string;
}

const { document, slug, title, sourceFile } = Astro.props;
const { Content, getHeadings } = document;
const { chapters } = getBook('zh-CN');
const outline = getHeadings().filter(({ depth }) => depth === 2 || depth === 3);
const supplemental = [
  { slug: 'introduction', title: '引言' },
  { slug: 'afterword', title: '后记' },
  { slug: 'reference-answers', title: '思考题参考答案' },
] as const;
---

<Layout locale="zh-CN" title={`${title} — 深入理解 AI Agent`} reader>
  <Header locale="zh-CN" />
  <main id="main-content" class="supplemental-page">
    <aside class="supplemental-nav" aria-label="全书目录">
      <a class="back-to-book" href={withBase('/')}>← 返回全书首页</a>
      <p class="rail-label">正文</p>
      <nav class="chapter-navigation">
        {chapters.map((chapter) => <a href={chapter.href}>{chapter.label} {chapter.title}</a>)}
      </nav>
      <p class="rail-label">补充内容</p>
      <nav class="chapter-navigation">
        {supplemental.map((item) => (
          <a class:list={{ active: item.slug === slug }} aria-current={item.slug === slug ? 'page' : undefined} href={withBase(`/${item.slug}/`)}>
            {item.title}
          </a>
        ))}
      </nav>
    </aside>
    <article class="supplemental-content">
      <p class="eyebrow">Serebii Labs · Offline mirror</p>
      <div class="prose"><Content /></div>
      <footer class="reader-footer">
        <a href={`${repo}/blob/main/${sourceFile}`}>查看原始正文 ↗</a>
        <a href={withBase('/SOURCE.md')}>来源与授权</a>
      </footer>
    </article>
    <aside class="supplemental-outline" aria-label="本页目录">
      <p class="rail-label">本页目录</p>
      <nav>
        {outline.map((heading) => <a class:list={{ subsection: heading.depth === 3 }} href={`#${heading.slug}`}>{heading.text}</a>)}
      </nav>
    </aside>
  </main>
</Layout>

<style>
  .supplemental-page { display: grid; grid-template-columns: minmax(210px, 270px) minmax(0, 760px) minmax(180px, 240px); gap: clamp(28px, 4vw, 72px); max-width: 1500px; margin: 0 auto; padding: 48px 32px 96px; }
  .supplemental-nav, .supplemental-outline { position: sticky; top: 28px; align-self: start; max-height: calc(100vh - 56px); overflow: auto; }
  .supplemental-content { min-width: 0; }
  .supplemental-content > .eyebrow { margin: 0 0 32px; }
  .supplemental-outline nav { display: grid; gap: 10px; }
  .supplemental-outline a { color: var(--muted); font-size: 0.82rem; line-height: 1.35; }
  .supplemental-outline a.subsection { padding-left: 14px; }
  @media (max-width: 1050px) { .supplemental-page { grid-template-columns: minmax(190px, 240px) minmax(0, 1fr); } .supplemental-outline { display: none; } }
  @media (max-width: 760px) { .supplemental-page { grid-template-columns: 1fr; padding: 28px 18px 72px; } .supplemental-nav { position: static; max-height: none; } }
</style>
